{
  "name": "@payload-forge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput & sleep 4 && node --watch --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@payload-forge/prisma": "0.1.0",
    "@payload-forge/shared": "0.1.0",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
